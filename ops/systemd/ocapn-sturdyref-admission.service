[Unit]
Description=Red Cup OCapN sturdyref admission provider
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/emsenn/.local/share/561-group/releases/ocapn-sturdyref-admission-service/current
Environment=HOST=127.0.0.1
Environment=PORT=18894
Environment=MAX_REQUEST_BYTES=16384
Environment=OCAPN_DATA_ROOT=/home/emsenn/.local/state/561-group/ocapn-sturdyref-admission-service
ExecStart=/usr/bin/node bin/server.mjs
Restart=on-failure

[Install]
WantedBy=default.target
